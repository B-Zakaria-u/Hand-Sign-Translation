<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.handsign.poc.ui.onboarding.OnboardingFragment"
        android:label="Welcome">
        <action
            android:id="@+id/action_onboarding_to_camera"
            app:destination="@id/cameraFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.handsign.poc.ui.camera.CameraFragment"
        android:label="Live" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.handsign.poc.ui.history.HistoryFragment"
        android:label="History" />

    <fragment
        android:id="@+id/modelManagerFragment"
        android:name="com.handsign.poc.ui.model.ModelManagerFragment"
        android:label="Model" />

</navigation>
